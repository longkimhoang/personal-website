# Where the site reads cv.yaml from (see src/cv/loader.ts). Set one of these.

# A local checkout of longkimhoang/cv, handy while editing both side by side.
# CV_YAML_PATH=../cv/cv.yaml

# Or fetch from GitHub: a fine-grained token with read-only Contents access
# to longkimhoang/cv. Set this in Vercel for Production and Preview.
# CV_GITHUB_TOKEN=
# CV_REF=main
