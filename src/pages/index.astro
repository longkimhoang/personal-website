---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import ExternalLinkIcon from "../components/ExternalLinkIcon.astro";
import Markdown from "../components/Markdown.astro";
import { companyDetails } from "../cv/companies";
import { formatMonth } from "../cv/format";
import Layout from "../layouts/Layout.astro";
import profileImage from "../images/profile.jpeg";

// All CV content comes from cv.yaml in longkimhoang/cv (see src/cv/loader.ts).
const cv = await getEntry("cv", "cv");
if (!cv) throw new Error("cv.yaml was not loaded");
const { basics, experience, skills, education, languages } = cv.data;

const dateRange = (start: string, end?: string | null) =>
  `${formatMonth(start)} - ${formatMonth(end)}`;
---

<Layout title={basics.name}>
  <main class="container mx-auto max-w-3xl mb-8 px-4 lg:px-0">
    <section id="about" class="mb-8">
      <div
        id="about-headline"
        class="flex flex-col-reverse md:flex-row gap-2 justify-between my-4"
      >
        <div>
          <h1 class="text-4xl font-semibold">{basics.name}</h1>
          <h2 class="text-xl">iOS Engineer</h2>
        </div>
        <Image
          src={profileImage}
          densities={[1, 2, 3]}
          alt="Profile"
          width={64}
          height={64}
          loading="eager"
          class="w-16 h-16 rounded-full object-top object-cover border dark:border-0"
        />
      </div>
      <p class="mt-2">
        An iOS engineer with 4 years of experience. I have a proven track record
        working on innovative, stable and high-performance enterprise-grade iOS
        applications in the instant messaging and banking domains. I value both
        good communication and technical skills, and is able to work in
        multi-national professional and agile teams, delivering meaningful user
        experiences.
      </p>
    </section>
    <section id="experience" class="mb-8">
      <h1 class="text-2xl font-semibold">Experience</h1>
      <ul>
        {
          experience.map(({ company, roles }) => {
            const { url, logo } = companyDetails[company] ?? {};
            return (
              <li class="my-6">
                <h2 class="flex item items-center gap-4 mb-2">
                  {logo ? (
                    <Image
                      width={48}
                      height={48}
                      fit="contain"
                      densities={[1, 2, 3]}
                      src={logo}
                      alt=""
                      loading="eager"
                      class="w-12 h-12 p-1 dark:bg-white object-contain"
                    />
                  ) : (
                    <span
                      aria-hidden="true"
                      class="w-12 h-12 shrink-0 flex items-center justify-center text-2xl font-semibold bg-gray-100 dark:bg-slate-800"
                    >
                      {company.charAt(0)}
                    </span>
                  )}
                  {url ? (
                    <a
                      href={url}
                      class="text-xl font-semibold hover:underline flex gap-1 items-center"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {company}
                      <ExternalLinkIcon />
                    </a>
                  ) : (
                    <span class="text-xl font-semibold">{company}</span>
                  )}
                </h2>
                {roles.map((role) => (
                  <ul class="list-disc list-inside mb-4 last:mb-0">
                    <li class="list-none">
                      <div class="mb-1">
                        <h3 class="text-lg font-medium">{role.title}</h3>
                        <p class="text-sm font-medium text-gray-500 dark:text-slate-400">
                          {dateRange(role.start, role.end)}
                        </p>
                      </div>
                    </li>
                    {role.highlights.map((highlight) => (
                      <li>
                        <Markdown text={highlight} />
                      </li>
                    ))}
                  </ul>
                ))}
              </li>
            );
          })
        }
      </ul>
    </section>
    <section id="skills" class="mb-8">
      <h1 class="text-2xl font-semibold mb-4">Skills</h1>
      <dl class="grid grid-cols-1 sm:grid-cols-[max-content_1fr] gap-x-6 gap-y-2">
        {
          skills.map(({ category, items }) => (
            <>
              <dt class="font-medium">{category}</dt>
              <dd class="mb-2 sm:mb-0">
                <Markdown text={items.join(", ")} />
              </dd>
            </>
          ))
        }
      </dl>
    </section>
    <section id="education" class="mb-8">
      <h1 class="text-2xl font-semibold">Education</h1>
      {
        education.map((entry) => (
          <div class="my-6">
            <h2 class="text-xl font-semibold">{entry.institution}</h2>
            <h3 class="text-lg font-medium">{entry.degree}</h3>
            <p class="text-sm font-medium text-gray-500 dark:text-slate-400 mb-1">
              {dateRange(entry.start, entry.end)}
            </p>
            <ul class="list-disc list-inside">
              {entry.highlights.map((highlight) => (
                <li>
                  <Markdown text={highlight} />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
    <section id="languages">
      <h1 class="text-2xl font-semibold mb-4">Languages</h1>
      <ul class="list-disc list-inside">
        {
          languages.map(({ language, fluency }) => (
            <li>
              <span class="font-medium">{language}</span>:{" "}
              <Markdown text={fluency} />
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>

<style>
  @media (min-width: 768px) {
    #about-headline {
      align-items: last baseline;
    }
  }
</style>
